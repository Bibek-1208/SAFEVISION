# SafeVision AI Server Configuration
PORT=5005
NODE_ENV=development

# MongoDB Connection (Local Replica Set)
MONGODB_URI=mongodb://127.0.0.1:27017/safevision?replicaSet=rs0

# AI Microservice URL
AI_SERVICE_URL=http://127.0.0.1:8000

# Security & Authentication
JWT_SECRET=safevision-hackathon-jwt-secret-key-super-secure-2026
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Application Settings
DEMO_MODE=false
TIMEZONE=Asia/Kolkata
PPE_CONFIDENCE=0.35
PPE_MODEL_PATH=ai/models/ppe/best.pt

# RTSP Camera Stream (Optional)
CAM_01_RTSP_URL=
CCTV_RTSP_USER=
CCTV_RTSP_PASS=
